<?xml version="1.0"?>
<launch>
  <!--
    sim_moveit_pick.launch - MoveIt-based pick-and-place for Unitree Z1 (Gazebo).

    Uses the pre-built z1_moveit_config/launch/gazebo.launch for all
    Gazebo/URDF/robot_state_publisher setup.

    Physics is kept PAUSED until the arm JointTrajectoryController enters
    the running state. This prevents the effort-based JTC from receiving
    wound-up joint positions caused by the arm falling before controllers load.

    After launch, run:
      rosrun z1_vision spawn_pick_objects.py  (with clear -n 3 args)
      rosrun z1_vision sim_pick_place.py
  -->

  <!-- 1. Gazebo + robot spawn + robot_state_publisher (pre-built) -->
  <!--    paused=true keeps physics frozen until unpause_when_ready fires  -->
  <!--    joint4 default 1.5707 exceeds URDF limit +-1.51844, use 1.50    -->
  <include file="$(find z1_moveit_config)/launch/gazebo.launch">
    <arg name="paused"                        value="true"/>
    <arg name="initial_joint_positions"
         value=" -J joint1 0 -J joint2 1.1 -J joint3 -1.1 -J joint4 1.50 -J joint5 0 -J joint6 0"/>
    <!-- arm_gripper_spawner below handles joint_state_controller inside /z1_gazebo; -->
    <!-- the root-namespace spawner in gazebo.launch can never reach /z1_gazebo/controller_manager -->
    <arg name="spawn_joint_state_controller" value="false"/>
  </include>

  <!-- 2. Arm + gripper controller configs in /z1_gazebo namespace -->
  <rosparam ns="z1_gazebo">
    joint_state_controller:
      type: joint_state_controller/JointStateController
      publish_rate: 50

    z1_joint_traj_controller:
      type: effort_controllers/JointTrajectoryController
      joints: [joint1, joint2, joint3, joint4, joint5, joint6]
      stop_trajectory_duration: 0.5
      state_publish_rate: 50
      action_monitor_rate: 20
      constraints:
        goal_time: 3.0
        joint1: {goal: 0.05}
        joint2: {goal: 0.05}
        joint3: {goal: 0.05}
        joint4: {goal: 0.05}
        joint5: {goal: 0.05}
        joint6: {goal: 0.05}
      gains:
        joint1: {p: 5000.0, i: 0.0, d: 100.0}
        joint2: {p: 5000.0, i: 0.0, d: 100.0}
        joint3: {p: 3000.0, i: 0.0, d:  50.0}
        joint4: {p: 2000.0, i: 0.0, d:  30.0}
        joint5: {p: 1000.0, i: 0.0, d:  20.0}
        joint6: {p:  500.0, i: 0.0, d:  10.0}

    gripper_position_controller:
      type: effort_controllers/JointPositionController
      joint: jointGripper
      pid: {p: 100.0, i: 0.0, d: 5.0}
  </rosparam>

  <!-- 3. Spawn all controllers in /z1_gazebo namespace -->
  <!--    joint_state_controller included here because gazebo.launch's    -->
  <!--    gazebo_controller_spawner has no ns and cannot reach /z1_gazebo  -->
  <node name="arm_gripper_spawner" pkg="controller_manager" type="spawner"
        ns="/z1_gazebo" respawn="false" output="screen"
        args="joint_state_controller z1_joint_traj_controller gripper_position_controller"/>

  <!-- 4. Relay /z1_gazebo/joint_states to /joint_states for MoveIt -->
  <node name="joint_states_relay" pkg="topic_tools" type="relay"
        args="/z1_gazebo/joint_states /joint_states" respawn="true" output="screen"/>

  <!-- 5. MoveIt planning context -->
  <include file="$(find z1_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="false"/>
  </include>

  <!-- 6. MoveIt move_group with simple controller manager -->
  <include file="$(find z1_moveit_config)/launch/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="moveit_controller_manager"  value="simple"/>
    <arg name="load_robot_description"     value="false"/>
    <arg name="info"                       value="true"/>
  </include>

  <!-- 7. Unpause physics only after arm controller is running -->
  <node name="unpause_when_ready" pkg="z1_vision" type="unpause_when_ready.py"
        output="screen"/>

</launch>
